{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hato",
  "version": "0.0.1",
  "identifier": "com.stephenshorton.hato",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hato 🐦",
        "width": 540,
        "height": 680,
        "minWidth": 440,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
